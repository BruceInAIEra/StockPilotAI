# Copy to /etc/stockpilot/runtime.env on the server, root-owned mode 0600.
# Plain KEY=value syntax; no shell expressions, quotes, spaces, or multiline values.
ACCESS_MODE=ssh
# For HTTPS later: set ACCESS_MODE=https and add SITE_DOMAIN=your.real.domain
POSTGRES_PASSWORD=GENERATE_64_HEX_CHARACTERS_LATER
OPENAI_API_KEY=SET_OPENAI_KEY_LATER
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_ALLOWED_MODELS=gpt-5-mini
# Must exactly match the Cognito app client's callback and sign-out origin.
# SSH test: use localhost:18000; public access: use https://your.real.domain
APP_BASE_URL=http://localhost:18000
COGNITO_USER_POOL_ID=us-west-2_REPLACE
COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
COGNITO_DOMAIN=https://REPLACE.auth.us-west-2.amazoncognito.com
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SESSION_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
