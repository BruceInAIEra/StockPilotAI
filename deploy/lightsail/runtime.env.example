# Copy to /etc/stockpilot/runtime.env on the server, root-owned mode 0600.
# Plain KEY=value syntax; no shell expressions, quotes, spaces, or multiline values.
SITE_DOMAIN=CHOOSE_DOMAIN_LATER
POSTGRES_PASSWORD=GENERATE_64_HEX_CHARACTERS_LATER
OPENAI_API_KEY=SET_OPENAI_KEY_LATER
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_ALLOWED_MODELS=gpt-5-mini
