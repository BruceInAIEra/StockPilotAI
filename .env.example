# OpenAI
# Keep the real key in .env or in your shell environment. Never commit it.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_ALLOWED_MODELS=gpt-5-mini,gpt-4.1-mini,gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///data/stockpilot.db
MARKET_DATA_TIMEOUT_SECONDS=20

